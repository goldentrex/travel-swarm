{
  "include": ["src/**/*.ts", "workers/**/*.ts", "vitest.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    // DOM is here for the fetch/Request/Response/Headers types only — the
    // swarm runs on Workers and Node, never in a browser. Without it the
    // provider clients and their tests fail on `RequestInfo`.
    "lib": ["ES2022", "DOM"],
    "types": ["node"],

    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": { "@/*": ["./src/*"] }
  }
}
